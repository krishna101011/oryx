{
  "expo": {
    "name": "Anant Capital",
    "slug": "anant-capital",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0A0A",
      "resizeMode": "contain"
    },
    "scheme": "anantcapital",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "capital.anant.app"
    },
    "android": {
      "package": "capital.anant.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A"
      }
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": ["expo-secure-store"]
  }
}
