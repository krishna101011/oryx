{
  "name": "oryx",
  "version": "0.1.0",
  "private": true,
  "description": "ORYX — premium finance intelligence platform (monorepo root)",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "mobile:dev": "pnpm --filter @oryx/mobile start",
    "backend:dev": "cd apps/backend && uv run uvicorn anant.main:app --reload --port 8000",
    "lint": "pnpm -r --parallel --filter \"!@oryx/backend\" run lint",
    "type-check": "pnpm -r --parallel --filter \"!@oryx/backend\" run type-check",
    "test": "pnpm -r --parallel --filter \"!@oryx/backend\" run test",
    "gen:pydantic": "tsx infra/scripts/gen-pydantic.ts",
    "drift:check": "tsx infra/scripts/gen-pydantic.ts --check"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5"
  }
}
