# ORYX — backend environment template.
# Copy this file to apps/backend/.env for local development.
# NEVER commit real secrets.

# --- environment ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
SERVICE_NAME=oryx-backend

# --- HTTP server ---
API_PREFIX=/v1

# CORS origins: comma-free JSON-style list.
# Defaults cover Expo dev server (8081) and Expo web (19006).
# Use the JSON form so pydantic-settings parses it as a list.
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# --- build metadata (populated by CI in real deploys) ---
BUILD_VERSION=0.1.0
BUILD_COMMIT=dev
