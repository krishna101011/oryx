# ORYX — backend environment template.
# Copy this file to apps/backend/.env for local development.
# NEVER commit real secrets.

# --- environment ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
SERVICE_NAME=oryx-backend

# --- HTTP server ---
API_PREFIX=/v1

# CORS origins: comma-free JSON-style list.
# Defaults cover Expo dev server (8081) and Expo web (19006).
# Use the JSON form so pydantic-settings parses it as a list.
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# --- build metadata (populated by CI in real deploys) ---
BUILD_VERSION=0.1.0
BUILD_COMMIT=dev

# --- dev worker colocation (Phase 3 CR-7 / ADR-025) ---
# Dev convenience: colocate all background workers INTO the single API
# process so one `uvicorn oryx.main:app` runs everything. When set (and
# environment=dev), main.py's lifespan starts the intake scheduler, the
# queue/outbox drainer, AND the Phase 5 Wave E calendar scheduler in-process.
# Production never colocates — it runs the API + each worker as separate
# processes (CR-7/ADR-025). Bound to settings.oryx_dev_monoprocess; the old
# ANANT_DEV_MONOPROCESS name no longer binds after the anant→oryx rename.
ORYX_DEV_MONOPROCESS=1
